# Copy to .env. Keep .env private; never commit credentials.
# Local access only by default. LAN/public access are explicit opt-ins.
PORT=3210
HOST=127.0.0.1

# Blank => generate a random 256-bit credential and save to local .env.
# Public tunnels require 24+ characters. Prefer the generated value.
RELAY_AUTH_TOKEN=

# Empty hostname/token selects a temporary URL when ENABLE_TUNNEL=true.
ENABLE_TUNNEL=false
CF_HOSTNAME=
CF_TUNNEL_NAME=codex-relay
CF_TUNNEL_TOKEN=
# Optional custom domain: use a hostname YOU control.
# CF_HOSTNAME=codex.example.com
CF_OVERWRITE_DNS=false
# false: reuse an existing named tunnel AND DNS route without creating either.
CF_MANAGE_DNS=true

AUTO_OPEN_QR=true
# Absolute path to YOUR Git workspace; default is the launch directory.
# Windows: CODEX_CWD=C:/work/my-project
# macOS/Linux: CODEX_CWD=/home/me/my-project
CODEX_CMD=codex
AUTO_START_CODEX=true
