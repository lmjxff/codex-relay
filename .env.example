# ==========================================================
# Codex Relay — Environment & Security Configuration
# ==========================================================

# Server port and bind address
PORT=3210
HOST=0.0.0.0

# Security: Access PIN / Token required by Web UI and WebSocket
# If left empty, you will be prompted on first interactive startup (or a random 6-digit PIN will be generated)
RELAY_AUTH_TOKEN=

# Cloudflare Tunnel Configuration
# Set ENABLE_TUNNEL=true to automatically start Cloudflare Tunnel on launch
ENABLE_TUNNEL=true

# Custom Cloudflare Domain (requires `npm run cf:login` once, or CF_TUNNEL_TOKEN below)
CF_HOSTNAME=codex.lmjjml.cc.cd
CF_TUNNEL_NAME=codex-relay

# Optional: Cloudflare Zero Trust Tunnel Token (if managing tunnel via Cloudflare Dashboard)
CF_TUNNEL_TOKEN=

# Target Git workspace and CLI command
# CODEX_CWD=E:\your-project
CODEX_CMD=codex
AUTO_START_CODEX=true
